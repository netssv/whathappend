{
    "manifest_version": 3,
    "name": "WhatHappened",
    "version": "3.0.2",
    "description": "Your friendly side panel terminal! Learn how to diagnose DNS, SSL, and email infrastructure using simple, guided commands.",
    "permissions": [
        "activeTab",
        "tabs",
        "sidePanel",
        "storage",
        "scripting",
        "cookies",
        "browsingData",
        "contentSettings",
        "declarativeNetRequest",
        "debugger",
        "alarms"
    ],
    "host_permissions": [
        "https://dns.google/*",
        "https://rdap.org/*",
        "https://crt.sh/*",
        "https://isitdown.site/*",
        "https://*/*",
        "http://*/*"
    ],
    "content_security_policy": {
        "extension_pages": "script-src 'self'; object-src 'self'"
    },
    "side_panel": {
        "default_path": "terminal.html"
    },
    "action": {
        "default_title": "WhatHappened — Web Infrastructure Triage",
        "default_icon": {
            "16": "icons/icon16.png",
            "48": "icons/icon48.png",
            "128": "icons/icon128.png"
        }
    },
    "background": {
        "service_worker": "background.js",
        "type": "module"
    },
    "icons": {
        "16": "icons/icon16.png",
        "48": "icons/icon48.png",
        "128": "icons/icon128.png"
    },
    "commands": {
        "_execute_action": {
            "suggested_key": {
                "default": "Ctrl+Shift+Period",
                "mac": "Command+Shift+Period"
            }
        },
        "reload-extension": {
            "suggested_key": {
                "default": "Ctrl+Shift+Comma",
                "mac": "Command+Shift+Comma"
            },
            "description": "Reload WhatHappened extension"
        },
        "run-start": {
            "description": "Run full triage on active tab"
        },
        "run-flush": {
            "description": "Flush cache for active domain"
        },
        "run-watch": {
            "description": "Start network traffic watcher"
        },
        "run-clear": {
            "description": "Clear terminal screen"
        },
        "run-clip": {
            "description": "Copy session to clipboard"
        }
    }
}